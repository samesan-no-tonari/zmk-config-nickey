#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E  &kp R  &kp T                              &kp Y    &kp U       &kp I      &kp O    &kp P     &kp SQT
&kp LCTRL  &kp A  &kp S  &kp D  &kp F  &kp G                              &kp H    &kp J       &kp K      &kp L    &kp SEMI  &kp MINUS
&kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp LEFT_WIN    &kp DELETE  &kp N    &kp M       &kp COMMA  &kp DOT  &kp FSLH  &kp EQUAL
                                &mo 1  &mo 2  &lt 3 SPACE     &kp BSPC    &kp RET  &lt 2 RALT
            >;
        };

        layer_1 {
            bindings = <
&kp ESCAPE  &kp F1        &kp F2        &kp F3        &kp F4        &kp F5                                    &kp F10           &kp F6                &kp F7                 &kp F8             &kp F9         &kp GRAVE
&trans      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5                                    &kp NUMBER_6      &kp N7                &kp N8                 &kp N9             &kt N0         &kp TILDE
&trans      &trans        &trans        &trans        &trans        &trans  &kt EXCL          &kt QUESTION    &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp BACKSLASH  &kt HASH
                                                      &trans        &trans  &kt LANGUAGE_2    &kp LANGUAGE_1  &trans            &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &kt EXCL   &kt AT         &kt HASH    &kt DOLLAR            &kt PERCENT                              &trans  &kt PAGE_UP    &kt UP_ARROW    &kt HOME   &trans  &trans
&trans  &kp CARET  &kp AMPERSAND  &kp DOLLAR  &kt LEFT_PARENTHESIS  &kt RIGHT_PARENTHESIS                    &trans  &kt LEFT       &kt DOWN_ARROW  &kt RIGHT  &trans  &trans
&trans  &trans     &trans         &trans      &trans                &trans                 &trans    &trans  &trans  &kt PAGE_DOWN  &kt LS(LG(S))   &kt END    &trans  &trans
                                              &trans                &trans                 &trans    &trans  &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&bt BT_CLR      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans  &trans  &trans  &trans  &trans  &studio_unlock
&bt BT_CLR_ALL  &trans        &trans        &trans        &trans        &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                                          &trans        &trans        &trans    &trans  &trans  &trans
            >;
        };
    };
};
